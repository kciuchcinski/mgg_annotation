manifest {
  name            = 'mgg_annotation'
  description     = 'Phage ORF prediction and PHROGs-enriched functional annotation'
  version         = '1.1'
  nextflowVersion = '>=25.04'
}

// ---------------------------------------------------------------------------
// Default parameters (override in your -params-file, e.g. config.yml)
// ---------------------------------------------------------------------------
params {
  PHAGES_DIR       = "${projectDir}/test/data"
  OUTPUT_DIR       = 'results'
  INPUT_EXTENSION  = 'fasta'
  PHAGE_MIN_LENGTH = 2000

  // Databases: everything is derived from DB_ROOT unless overridden below
  DB_ROOT       = "${projectDir}/databases"
  GLIMMER_TRAIN = null   // default: DB_ROOT/training-file_refseq.icm, else resources/training-file_refseq.icm
  HHSUITE       = [:]    // optional per-db prefixes: PHROGS, PFAM, ECOD
  METADATA      = [:]    // optional: PHROGS_TABLE

  WRITE_SEARCH_TABLE     = true
  WRITE_ANNOTATION_TABLE = true
  PUBLISH_INTERMEDIATES  = false
  N_FUNCTIONS_PER_DB     = 2

  ANNOTATION_FILTERS = [
    PHROGS:     [MIN_PROB: 0.7, MIN_QCOV: 0.1, MIN_TCOV: 0.1],
    DOMAIN_DBS: [MIN_PROB: 0.7, MIN_QCOV: 0.1, MIN_TCOV: 0.1]
  ]

  CLUSTERING = [IDENTITY: 0.5, COVERAGE: 0.8, EVAL: 0.001, SENSITIVITY: 7.5]

  // HHsuite iterations per database
  n_iter_phrogs = 1
  n_iter_pfam   = 2
  n_iter_ecod   = 2

  // Execution & batching
  BATCH_SIZE        = 20
  chunk_size_a3m    = null   // defaults to BATCH_SIZE
  THREADS_PER_BATCH = 4
  ENRICH_CPUS       = 4
  PARSING_CPUS      = 4
  SEARCH_TOOL       = 'hhblits_omp'

  // Laptop limits (docker / standard profiles)
  MAX_CPUS   = 8
  MAX_MEMORY = '7 GB'
}

params.chunk_size_a3m = params.chunk_size_a3m ?: params.BATCH_SIZE

profiles {
  // Used when no -profile is given: Docker with laptop-sized limits
  standard {
    includeConfig 'conf/docker.config'
  }

  docker {
    includeConfig 'conf/docker.config'
  }

  apptainer {
    process {
      withName: '.*' {
        container = 'phage_annotation.sif'
        // No explicit -B for DB_ROOT: databases are staged as path inputs, so autoMounts binds
        // them (a relative DB_ROOT here would be resolved inside each task's work directory)
        errorStrategy = 'retry'
        maxRetries = 2
      }
    }
    singularity {
      enabled = true
      autoMounts = true
    }
    // HPC node sizing
    executor {
      cpus = 64
      memory = '256 GB'
    }
  }

  // Not supported on Apple Silicon (glimmer has no osx-arm64 build)
  conda {
    process {
      withName: '.*' {
        conda = '/path/to/envs/phage_annotation'
      }
    }
    conda {
      enabled = true
      useMicromamba = true
    }
    singularity {
      enabled = false
    }
  }
}
