Bootstrap: docker
From: mambaorg/micromamba:2.9.0-debian13

%post
    apt-get update && apt-get install -y procps && rm -rf /var/lib/apt/lists/*
    # Keep in sync with environment.yml and Dockerfile
    micromamba install -y -n base -c conda-forge -c bioconda \
        python=3.11 \
        biopython=1.79 \
        pandas=3.0.2 \
        numpy=2.4.4 \
        hhsuite=3.3.0 \
        mmseqs2=16.747c6 \
        glimmer=3.02 \
        prodigal-gv=2.11.0 \
        pip && \
    micromamba run -n base pip install --no-cache-dir csb==1.2.5 && \
    micromamba clean --all --yes

%environment
    # The base environment is activated by default in micromamba images
    export PATH="/opt/conda/bin:$PATH"
