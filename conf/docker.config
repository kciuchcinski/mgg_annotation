// Docker settings for laptops / workstations (macOS, Linux).
// Used by both the `standard` (default) and `docker` profiles.

docker {
  enabled    = true
  // Run as the calling user so files written to the work dir are owned by you (Linux hosts)
  runOptions = '-u $(id -u):$(id -g)'
}

conda.enabled       = false
singularity.enabled = false
apptainer.enabled   = false

// Total resources Nextflow may use at once. Keep MAX_MEMORY at or below the memory
// given to Docker Desktop (Settings > Resources > Memory).
executor {
  cpus   = params.MAX_CPUS
  memory = params.MAX_MEMORY
}

process {
  container      = 'phage_annotation:latest'
  errorStrategy  = 'retry'
  maxRetries     = 2
  resourceLimits = [cpus: params.MAX_CPUS, memory: params.MAX_MEMORY]

  memory = { 2.GB * task.attempt }

  withName: 'ENRICH_MSA_PHROGS|HHSUITE_SEARCH_BATCH|CLUSTERING|PREPARE_A3M|COLLECT_HITS|BUILD_ANNOTATION' {
    memory = { 4.GB * task.attempt }
  }
}
