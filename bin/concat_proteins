#!/usr/bin/env python3
import argparse
import shutil
from pathlib import Path

def parse_args():
    ap = argparse.ArgumentParser(description="Concatenate multiple protein FASTA files")
    ap.add_argument("inputs", nargs="+", help="Input protein FASTA files")
    ap.add_argument("--output", required=True, help="Output concatenated FASTA path")
    return ap.parse_args()

def main():
    args = parse_args()
    out = Path(args.output)
    out.parent.mkdir(parents=True, exist_ok=True)
    with open(out, "wb") as wfd:
        for fp in args.inputs:
            with open(fp, "rb") as fd:
                shutil.copyfileobj(fd, wfd)
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
