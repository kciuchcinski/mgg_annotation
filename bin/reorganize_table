#!/usr/bin/env python3
import argparse
from pathlib import Path
import pandas as pd


def parse_args():
    ap = argparse.ArgumentParser(description="Concatenate per-contig confident ORF tables into one CSV")
    ap.add_argument("--inputs", nargs="+", required=True, help="Input CSVs from confident_orfs_tables")
    ap.add_argument("--output", required=True, help="Output confident_orfs.csv")
    return ap.parse_args()


def main():
    args = parse_args()
    inputs = [Path(x) for x in args.inputs]

    # Read all inputs unconditionally and concatenate
    dfs = [pd.read_csv(p) for p in inputs]
    df = pd.concat(dfs, ignore_index=True)

    # Compute lengths exactly as required for downstream
    df["protein_len"] = df["protein"].apply(len)
    if "orf_len" not in df.columns:
        df["orf_len"] = df["orf"].apply(len)

    # Compute proteinID concatenation
    df["proteinID"] = df.apply(lambda row: f"{row['contigID']}_{row['proteinID']}", axis=1)

    # Reorder columns
    cols = [
        "proteinID",
        "start",
        "stop",
        "strand",
        "contigID",
        "orf_len",
        "protein_len",
        "codon_stop",
        "source",
        "protein",
        "orf",
    ]
    df = df[cols]

    out = Path(args.output)
    out.parent.mkdir(parents=True, exist_ok=True)
    df.to_csv(out, index=False)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())