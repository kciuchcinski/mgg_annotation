#!/usr/bin/env python3
"""
Collect raw HHsuite hits and metadata into a single per-hit table (search.tsv).
"""

import sys
import os
from pathlib import Path
import argparse

import pandas as pd
import numpy as np
from csb.bio.io import HHOutputParser


def get_phrog(row):
    """ get phrog cluster """
    if 'phrog_' in str(row['target']):
        return int(row['target'].split('_')[-1])
    else:
        return 0


def get_hits(tables, dbname='UNKNOWN'):
    """Parse .hhr files into a per-hit DataFrame."""
    colnames = [
        'query', 'target', 'qstart', 'qend', 'qlength',
        'tstart', 'tend', 'tlength', 'ident',
        'bits', 'evalue', 'prob', 'pvalue', 'name'
    ]

    rows, corrupted, parser = [], [], HHOutputParser()
    for table in tables:
        try:
            parsed_table = parser.parse_file(table)
        except Exception:
            corrupted.append(table)
            continue

        qname = parsed_table.query_name
        for hit in parsed_table:
            hit_values = [
                qname,
                hit.id,
                hit.qstart,
                hit.qend,
                hit.qlength,
                hit.start,
                hit.end,
                hit.slength,
                round(int(hit.identity) / 100, 2),
                hit.score,
                hit.evalue,
                hit.probability,
                hit.pvalue,
                hit.name,
            ]
            rows.append(hit_values)

    df = pd.DataFrame(rows, columns=colnames)
    if df.empty:
        df['db'] = dbname
        return df

    df['prob'] = np.round(df['prob'], 3)
    df['qcov'] = np.round(np.abs(df['qstart'] - 1 - df['qend']) / df['qlength'], 2)
    df['tcov'] = np.round(np.abs(df['tstart'] - 1 - df['tend']) / df['tlength'], 2)
    df['db'] = dbname

    colfinal = [
        'query', 'target', 'prob', 'pvalue', 'ident', 'qcov', 'tcov',
        'bits', 'qstart', 'qend', 'qlength', 'tstart', 'tend', 'tlength',
        'evalue', 'db', 'name'
    ]
    return df[colfinal]


def main():
    parser = argparse.ArgumentParser(
        description="Collect raw HHsuite hits from multiple databases into search.tsv"
    )
    parser.add_argument("--pcs2proteins", required=True, help="PCs2proteins.tsv (not used here, kept for interface consistency)")
    parser.add_argument("--phrogs-dir", required=True, help="Directory with PHROGS .a3m files")
    parser.add_argument("--alan-dir", required=True, help="Directory with ALANDB .a3m files")
    parser.add_argument("--pfam-dir", required=True, help="Directory with PFAM .a3m files")
    parser.add_argument("--ecod-dir", required=True, help="Directory with ECOD .a3m files")
    parser.add_argument("--phrogs-table", required=True, help="PHROGS metadata table (TSV)")
    parser.add_argument("--alan-table", required=True, help="ALAN metadata table (TSV or CSV)")
    parser.add_argument("--write-search", required=True, help="Boolean flag: write search.tsv or not")
    parser.add_argument("--out-search", required=True, help="Output path for search.tsv")

    args = parser.parse_args()

    write_search = str(args.write_search).lower() in {"1", "true", "yes", "y"}

    print("Loading a3m file lists... ", end="")
    phrogs_tables = list(Path(args.phrogs_dir).glob("*.a3m"))
    alan_tables = list(Path(args.alan_dir).glob("*.a3m"))
    pfam_tables = list(Path(args.pfam_dir).glob("*.a3m"))
    ecod_tables = list(Path(args.ecod_dir).glob("*.a3m"))
    print("Done!")

    print("Parsing A3M hits... ", end="")
    phrogs_df = get_hits(phrogs_tables, dbname="PHROGS")
    alan_df = get_hits(alan_tables, dbname="ALANDB")
    pfam_df = get_hits(pfam_tables, dbname="PFAM")
    ecod_df = get_hits(ecod_tables, dbname="ECOD")
    print("Done!")

    # Load PHROGS and ALAN metadata and attach basic fields (optional at this stage)
    print("Loading PHROGS & ALAN metadata... ", end="")
    phrogs_annot_df = pd.read_csv(args.phrogs_table, sep="\t")
    # mgg_phrogs_table usage removed; use phrogs_table as is
    phrogs_annot_df = phrogs_annot_df[
        ["phrog", "color", "annot", "category"]
    ].fillna("unknown function")

    alan_annot_df = pd.read_csv(args.alan_table, sep=None, engine="python")
    alan_annot_df = alan_annot_df.rename(
        columns={
            "definition": "annot",
            "funct": "category",
            "profile": "alan_profile",
        }
    )
    alan_drop_cols = [
        c
        for c in [
            "abbrev",
            "hmm.name",
            "family.name",
            "family.name.base",
            "where.it.occurs",
            "is.custom",
            "custom.hmm.exists",
        ]
        if c in alan_annot_df.columns
    ]
    alan_annot_df = alan_annot_df.drop(columns=alan_drop_cols, errors="ignore")
    print("Done!")

    # Attach metadata but do not do best-hit selection here
    print("Attaching PHROGS and ALAN metadata... ", end="")
    if not phrogs_df.empty:
        phrogs_df["phrog"] = phrogs_df.apply(get_phrog, axis=1)
        phrogs_df = phrogs_df.merge(phrogs_annot_df, on="phrog", how="left")

    if not alan_df.empty:
        alan_df["alan_profile"] = alan_df["target"]
        alan_df = alan_df.merge(alan_annot_df, on="alan_profile", how="left")
    print("Done!")

    print("Combining all hits... ", end="")
    df = pd.concat([phrogs_df, alan_df, pfam_df, ecod_df], axis=0, ignore_index=True)

    if df.empty:
        print("No hits found, writing empty search.tsv.")
        Path(args.out_search).parent.mkdir(parents=True, exist_ok=True)
        df.to_csv(args.out_search, sep="\t", index=False)
        return

    df[["phrog", "alan_profile"]] = df.get(
        ["phrog", "alan_profile"], pd.DataFrame(columns=["phrog", "alan_profile"])
    ).fillna("0")
    df["phrog"] = df["phrog"].astype(int, errors="ignore")

    df["tmp"] = df["query"].str.strip("PC").astype(int, errors="ignore")
    df = df.sort_values("tmp", ascending=True).drop(columns=["tmp"])

    # Always write search.tsv for downstream processes
    print(f"Writing search table to {args.out_search} ... ", end="")
    Path(args.out_search).parent.mkdir(parents=True, exist_ok=True)
    df.to_csv(args.out_search, sep="\t", index=False)
    print("Done!")


if __name__ == "__main__":
    main()