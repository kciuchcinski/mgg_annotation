#!/usr/bin/env python3
"""
Generate GenBank files of prophages with dynamic annotation columns.
"""

import argparse
import pandas as pd
from pathlib import Path
from Bio import SeqIO
from Bio.Seq import Seq
from Bio.SeqFeature import SeqFeature, FeatureLocation
from Bio.SeqRecord import SeqRecord

def main():
    parser = argparse.ArgumentParser(description='Generate GenBank files of prophages')
    parser.add_argument('--annotation', required=True, help='Annotation TSV')
    parser.add_argument('--metadata', required=True, help='Metadata TSV with sequences')
    parser.add_argument('--outdir', required=True, help='Output directory for GenBank files')
    args = parser.parse_args()

    annotation_path = args.annotation
    metadata_path = args.metadata
    genbank_dir = Path(args.outdir)
    genbank_dir.mkdir(exist_ok=True, parents=True)

    # Load inputs
    print(f"Loading annotation from {annotation_path}...")
    annotation_df = pd.read_csv(annotation_path, sep='\t')
    print(f"Loading metadata from {metadata_path}...")
    metadata_df = pd.read_csv(metadata_path, sep='\t')

    # Handle case where annotation file is empty
    if annotation_df.empty:
        print("Annotation file is empty. No GenBank files will be generated.")
        return

    # Extract contigID from proteinID if not present
    if 'contigID' not in annotation_df.columns and 'proteinID' in annotation_df.columns:
        # Regex provided in original script
        annotation_df['contigID'] = annotation_df['proteinID'].str.split(r'_PROTEIN_*', expand=True)[0]

    # Identify dynamic annotation columns
    # We want columns like 'PHROGS1_function' -> key 'PHROGS1'
    # and 'PHROGS1_params' -> key 'PHROGS1_params'
    function_cols = [c for c in annotation_df.columns if c.endswith('_function')]
    params_cols = [c for c in annotation_df.columns if c.endswith('_params')]
    
    # Sort them to ensure deterministic order in qualifiers if needed
    function_cols.sort()
    params_cols.sort()

    print(f"Found function columns: {function_cols}")
    print(f"Found params columns: {params_cols}")

    # Group by contigID and write GenBank files
    for phageID, group in annotation_df.groupby('contigID'):
        
        # Get phage nucleotide sequence
        seq_row = metadata_df[metadata_df['contigID'] == phageID]
        if seq_row.empty:
            print(f"Warning: No sequence found in metadata for contigID {phageID}")
            continue
        
        # Create SeqRecord
        seq_str = seq_row['seq'].values[0]
        record = SeqRecord(Seq(seq_str), id=str(phageID))
        record.annotations['molecule_type'] = 'DNA'
        record.name = str(phageID)[:16]  # GenBank locus tag limit is mostly strict on older parsers
        record.description = f"Prophage {phageID}"
        record.organism = 'Phage'

        features = []
        for _, row in group.iterrows():
            # Basic location info
            start, stop, strand = row['start'], row['stop'], row['strand']
            
            # Ensure valid genomic interval
            left = min(int(start), int(stop))
            right = max(int(start), int(stop))
            strand_int = -1 if str(strand) == '-' else 1

            # Base qualifiers
            qualifiers = {
                'proteinID': [str(row['proteinID'])],
                'PC': [str(row.get('PC', '-'))],
                'seq': [str(row.get('orf', ''))],
                'translation': [str(row.get('protein', ''))],
            }

            # Add function qualifiers dynamically
            # e.g. row['PHROGS1_function'] -> qualifiers['PHROGS1']
            for col in function_cols:
                val = row[col]
                # Filter out NaNs if any, but keep '-' if that's your format
                if pd.notna(val):
                    key = col.replace('_function', '')  # PHROGS1_function -> PHROGS1
                    qualifiers[key] = [str(val)]

            # Add param qualifiers dynamically
            # e.g. row['PHROGS1_params'] -> qualifiers['PHROGS1_params']
            for col in params_cols:
                val = row[col]
                if pd.notna(val):
                    key = col  # Keep full name for params
                    qualifiers[key] = [str(val)]

            feature = SeqFeature(
                FeatureLocation(left - 1, right, strand=strand_int),
                type='CDS',
                qualifiers=qualifiers
            )
            features.append(feature)

        record.features = features
        
        # Write to file
        genbank_path = genbank_dir / f"{phageID}.gb"
        with open(genbank_path, 'w') as f:
            SeqIO.write(record, f, 'genbank')

    print(f"GenBank generation complete. Output in: {genbank_dir}")

if __name__ == '__main__':
    main()