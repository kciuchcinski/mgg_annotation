#!/usr/bin/env python3
import argparse
from pathlib import Path
import pandas as pd
from Bio import SeqIO
from Bio.SeqRecord import SeqRecord


def parse_args():
    ap = argparse.ArgumentParser(
        description="Split a combined MSA (A3M/FASTA-like) into per-PC A3Ms using PCs2proteins mapping"
    )
    ap.add_argument("--msa", required=True, help="Cleaned combined MSA (A3M) containing all proteinIDs")
    ap.add_argument("--map", required=True, help="PCs2proteins.tsv with columns: PC, proteinID, repr")
    ap.add_argument("--outdir", required=True, help="Output directory for per-PC A3Ms")
    return ap.parse_args()


def main():
    args = parse_args()
    msa_path = Path(args.msa)
    map_path = Path(args.map)
    outdir = Path(args.outdir)
    outdir.mkdir(parents=True, exist_ok=True)

    pcs = pd.read_csv(map_path, sep="\t")
    req = {"PC", "proteinID", "repr"}
    missing = req - set(pcs.columns)
    if missing:
        raise ValueError(f"PCs2proteins mapping missing columns: {sorted(missing)}")

    records = list(SeqIO.parse(msa_path, "fasta"))
    if not records:
        return 0

    by_id = {rec.id: rec for rec in records}

    for pc, group in pcs.groupby("PC", sort=False):
        # Representative first — defines match columns
        repr_ids = group.loc[group["repr"] == True, "proteinID"].tolist()
        other_ids = group.loc[group["repr"] != True, "proteinID"].tolist()
        pids = repr_ids + other_ids

        pc_records = []
        for pid in pids:
            rec = by_id.get(pid)
            if rec is None:
                continue
            rec_copy = SeqRecord(rec.seq, id=rec.id, name="", description="")
            pc_records.append(rec_copy)

        if not pc_records:
            continue

        pc_records[0].id = pc
        
        out_a3m = outdir / f"{pc}.a3m"
        with open(out_a3m, "w") as f:
            f.write("#A3M#\n")
            SeqIO.write(pc_records, f, "fasta")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
