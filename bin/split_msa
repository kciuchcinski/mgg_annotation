#!/usr/bin/env python3
import argparse
from pathlib import Path
import pandas as pd
from Bio import SeqIO
from Bio.SeqRecord import SeqRecord


def parse_args():
    ap = argparse.ArgumentParser(
        description="Split a combined MSA (A3M/FASTA-like) into per-PC A3Ms using PCs2proteins mapping"
    )
    ap.add_argument("--msa", required=True, help="Cleaned combined MSA (A3M) containing all proteinIDs")
    ap.add_argument("--map", required=True, help="PCs2proteins.tsv with columns: PC, proteinID, repr")
    ap.add_argument("--outdir", required=True, help="Output directory for per-PC A3Ms")
    return ap.parse_args()


def main():
    args = parse_args()
    msa_path = Path(args.msa)
    map_path = Path(args.map)
    outdir = Path(args.outdir)
    outdir.mkdir(parents=True, exist_ok=True)

    # Load mapping
    pcs = pd.read_csv(map_path, sep="\t")
    req = {"PC", "proteinID"}
    missing = req - set(pcs.columns)
    if missing:
        raise ValueError(f"PCs2proteins mapping missing columns: {sorted(missing)}")

    # Load all records; treat as FASTA/A3M (Biopython handles aligned sequences as plain sequences)
    records = list(SeqIO.parse(msa_path, "fasta"))
    if not records:
        # Nothing to split; exit successfully
        return 0

    # Index proteinID -> record; note: record.id must match proteinID exactly
    by_id = {rec.id: rec for rec in records}

    # For each PC, assemble records in mapping order
    for pc, group in pcs.groupby("PC", sort=False):
        pids = group["proteinID"].tolist()
        pc_records = []
        for pid in pids:
            rec = by_id.get(pid)
            if rec is None:
                continue
            # Shallow copy to avoid header mutation side-effects
            rec_copy = SeqRecord(rec.seq, id=rec.id, name=rec.name, description=rec.description)
            pc_records.append(rec_copy)

        if not pc_records:
            continue

        # Set the first header to the PC id, no description
        pc_records[0].id = pc
        pc_records[0].name = ""
        pc_records[0].description = ""

        out_a3m = outdir / f"{pc}.a3m"
        SeqIO.write(pc_records, out_a3m, "fasta")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
